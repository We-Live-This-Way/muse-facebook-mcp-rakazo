# Required. HTTP bearer secret for the /mcp endpoint. Generate your own and
# send it as: Authorization: Bearer <your-mcp-bearer-secret>
FB_MCP_BEARER=your-mcp-bearer-secret

# Facebook credentials can live in this same file:
FB_PAGE_ID=your-page-id
FB_PAGE_TOKEN=your-page-access-token
FB_LONG_TOKEN=your-long-lived-user-token
# Required: the app secret, used to sign every Graph call with appsecret_proof
# (so "Require App Secret" can stay on in the Meta app settings).
FB_APP_SECRET=your-app-secret

# Or point at another .env that already has the Facebook keys (this file's
# values win if both are set):
# FB_SHARED_ENV=/path/to/muse-facebook-mcp-draft/.env

# Optional listen port (default 8891). The server binds to 127.0.0.1 only.
# FB_MCP_PORT=8891
